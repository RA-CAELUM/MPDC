# MPDC default model for 6 GB GPUs (RTX 3050 6GB class).
# Created by scripts/setup-ollama-model.sh as `mpdc-qwen3-4b`.
FROM qwen3:4b-instruct-2507-q4_K_M

# Context per parallel slot. With OLLAMA_NUM_PARALLEL=2 the server runs two
# 16k slots (coder + independent tester) in the same VRAM one 32k slot would
# use (~5.2 GB with q8_0 KV cache). Ollama's OpenAI API can't set this per
# request, so it is pinned here.
PARAMETER num_ctx 16384

# Qwen's recommended sampling for Instruct-2507 (requests may override temperature/top_p).
PARAMETER temperature 0.7
PARAMETER top_p 0.8
PARAMETER top_k 20
PARAMETER min_p 0
